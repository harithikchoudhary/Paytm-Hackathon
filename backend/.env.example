# demo uses deterministic parsing of synthetic samples. cloud uses REAL Vertex AI + Document AI.
ONEFLOW_MODE=demo
ONEFLOW_DATA_DIR=data
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
VERTEX_MODEL=gemini-2.5-flash
AI_PROVIDER=gemini
SARVAM_API_KEY=
SARVAM_CHAT_MODEL=sarvam-105b
SARVAM_DOCUMENT_MODEL=sarvam-vision-v1
SARVAM_BASE_URL=https://api.sarvam.ai
DOCUMENT_AI_LOCATION=us
DOCUMENT_AI_PROCESSOR_ID=
# Optional: set GOOGLE_APPLICATION_CREDENTIALS outside this file, or use gcloud ADC.
FRONTEND_ORIGIN=http://localhost:5173
